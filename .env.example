# Every variable here is optional when you use the setup page on first run.
# Set them to configure by environment instead; they take precedence.

# --- Enable Banking application (https://enablebanking.com/cp/applications) ---
EB_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem
# EB_PRIVATE_KEY=

# --- This server ---
BASE_URL=https://bankconnector.onrender.com
PORT=8080

# Password for /balances login. Recommended: scrypt hash from `npm run hash-password`.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=

# APP_NAME=BankConnector
DEFAULT_COUNTRY=GR
DATA_DIR=./data

# GOOGLE_SHEETS_WEBHOOK_URL=
# CRON_SECRET=

# --- Viva Wallet (optional) ---
# VIVA_MERCHANT_ID=
# VIVA_API_KEY=

# --- Airwallex (optional) ---
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_ACCOUNT_ID=

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=

# --- PayPal (optional) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
